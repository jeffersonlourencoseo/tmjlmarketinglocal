---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import { siteConfig, localBusinessSchema } from "../data/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  canonical?: string;
  noindex?: boolean;
  article?: {
    pubDate?: Date;
    updatedDate?: Date;
    author?: string;
    tags?: string[];
  };
}

const { title, description, image, type, canonical, noindex, article } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonical={canonical}
      noindex={noindex}
      article={article}
      jsonLd={[localBusinessSchema]}
    />
    <link rel="icon" type="image/svg+xml" href={siteConfig.brand.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="antialiased bg-secondary text-primary">
    <slot />
  </body>
</html>
