---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../data/config";

export async function getStaticPaths() {
  const services = await getCollection("servicos");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const whatsappLink = siteConfig.contact.whatsappLink;

const features = service.data.features || [];
const benefits = service.data.benefits || [];
const applications = service.data.applications || [];
---

<Layout
  title={service.data.title}
  description={service.data.description}>
  <Header />
  <main class="pt-24 bg-secondary">
    <!-- Hero do serviço -->
    <section class="relative py-28 lg:py-36 bg-primary overflow-hidden">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent/10 rounded-full blur-[140px] -translate-y-1/2 translate-x-1/3"></div>
      </div>

      <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl">
          <p class="text-accent font-semibold tracking-[0.2em] uppercase text-sm mb-6">
            Serviço
          </p>
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-8">
            {service.data.title}
          </h1>
          <p class="text-lg md:text-xl text-white/70 max-w-2xl leading-relaxed">
            {service.data.description}
          </p>
        </div>
      </div>
    </section>

    <section class="py-28 lg:py-36">
      <div class="container mx-auto px-6 lg:px-12">
        <div class="max-w-5xl mx-auto">
          <!-- Conteúdo principal -->
          <article class="prose prose-lg prose-slate max-w-none mb-20">
            <Content />
          </article>

          <!-- Especificações / O que está incluso -->
          {features.length > 0 && (
            <div class="mb-20">
              <h2 class="font-display text-3xl md:text-4xl font-bold text-primary mb-10">
                O que está incluso
              </h2>
              <div class="grid md:grid-cols-2 gap-6">
                {features.map((feature) => (
                  <div class="flex items-start gap-4 p-6 bg-surface rounded-xl border border-gold">
                    <svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-lg text-primary leading-relaxed">{feature}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Benefícios -->
          {benefits.length > 0 && (
            <div class="mb-20">
              <h2 class="font-display text-3xl md:text-4xl font-bold text-primary mb-10">
                Benefícios para o seu negócio
              </h2>
              <div class="grid md:grid-cols-2 gap-6">
                {benefits.map((benefit) => (
                  <div class="flex items-start gap-4 p-6 bg-primary rounded-xl text-white">
                    <svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    <span class="text-lg leading-relaxed">{benefit}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Aplicações -->
          {applications.length > 0 && (
            <div class="mb-20">
              <h2 class="font-display text-3xl md:text-4xl font-bold text-primary mb-10">
                Para quem é indicado
              </h2>
              <div class="flex flex-wrap gap-3">
                {applications.map((application) => (
                  <span class="px-5 py-3 bg-surface border border-gold rounded-full text-primary font-medium">
                    {application}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- CTA de fechamento -->
          <div class="p-10 lg:p-12 bg-primary rounded-2xl text-white text-center">
            <h2 class="font-display text-3xl font-bold mb-4">
              Quer contratar este serviço?
            </h2>
            <p class="text-white/70 mb-8 max-w-2xl mx-auto">
              Fale com a gente pelo WhatsApp e receba uma proposta personalizada para o seu negócio no Rio de Janeiro.
            </p>
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-8 py-4 bg-accent text-primary font-bold rounded-full hover:bg-accent-light transition-all duration-200"
            >
              Solicitar proposta
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
