---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const services = await getCollection("servicos");
services.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Serviços | TMJL Marketing Local — Google Meu Negócio Rio de Janeiro"
  description="Conheça os serviços da TMJL Marketing Local: criação de perfil, otimização local e gestão de reputação no Google Meu Negócio.">
  <Header />
  <main class="pt-24 bg-secondary">
    <section class="relative py-28 lg:py-36 bg-primary overflow-hidden">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent/10 rounded-full blur-[140px] -translate-y-1/2 translate-x-1/3"></div>
      </div>

      <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl">
          <p class="text-accent font-semibold tracking-[0.2em] uppercase text-sm mb-6">
            Serviços
          </p>
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-8">
            Tudo para seu perfil local vender mais
          </h1>
          <p class="text-lg md:text-xl text-white/90 max-w-2xl leading-relaxed">
            Soluções completas para Google Meu Negócio, do cadastro inicial à gestão contínua de resultados.
          </p>
        </div>
      </div>
    </section>

    <section class="py-28 lg:py-36">
      <div class="container mx-auto px-6 lg:px-12">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12">
          {services.map((service) => (
            <a
              href={`/servicos/${service.id}/`}
              class="group relative block p-10 lg:p-12 bg-surface rounded-2xl border border-gold hover:border-accent/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5"
            >
              <div class="absolute top-8 right-8 font-display text-5xl text-accent/10 group-hover:text-accent/20 transition-colors duration-300">
                {String(service.data.order).padStart(2, "0")}
              </div>
              <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-300">
                <span class="text-accent font-display text-xl font-bold">{String(service.data.order).padStart(2, "0")}</span>
              </div>
              <h2 class="font-display text-2xl lg:text-3xl font-bold text-primary mb-4">
                {service.data.title}
              </h2>
              <p class="text-muted leading-relaxed mb-6">
                {service.data.description}
              </p>
              <span class="inline-flex items-center gap-2 text-accent font-semibold group-hover:gap-3 group-hover:scale-105 active:scale-95 transition-all duration-200">
                Saiba mais
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
