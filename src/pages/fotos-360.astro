---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ClientCard360 from "../components/ClientCard360.astro";
import PanoramaViewer from "../components/PanoramaViewer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { clients } from "../data/clients.ts";
---

<Layout
  title="Fotos 360° e Tour Virtual | TMJL Marketing Local"
  description="Portfólio de fotos 360° e tours virtuais de estabelecimentos no Rio de Janeiro. TMJL Marketing Local."
>
  <Header />

  <main class="pt-24 bg-surface-dark">
    <section class="relative py-32 lg:py-40 border-b border-white/5 overflow-hidden">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent/10 rounded-full blur-[140px] -translate-y-1/2 translate-x-1/4"></div>
      </div>

      <div class="container mx-auto px-6 lg:px-12 relative text-center">
        <p class="text-accent font-semibold tracking-[0.2em] uppercase text-sm mb-6">
          Portfólio
        </p>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-white leading-tight mb-8">
          Fotos 360° e Tour Virtual
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-3xl mx-auto leading-relaxed">
          Experiências imersivas para restaurantes, bares, academias, clínicas, escolas e comércios locais no Rio de Janeiro.
        </p>
      </div>
    </section>

    <section class="py-28 lg:py-36">
      <div class="container mx-auto px-6 lg:px-12">
        <div class="mb-20 lg:mb-24 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent mb-3">
            Alguns dos nossos clientes
          </p>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white">
            Clique para explorar os ambientes
          </h2>
        </div>

        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {clients.map((client) => <ClientCard360 client={client} />)}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <PanoramaViewer />
  <WhatsAppFloat />
</Layout>
