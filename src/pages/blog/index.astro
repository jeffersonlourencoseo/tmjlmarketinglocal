---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Closing from '../../components/Closing.astro';
import { breadcrumb } from '../../data/schema';
import { site } from '../../data/config';

const posts = (await getCollection('blog')).sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const schema = [
  breadcrumb([{ name: 'Blog', path: '/blog/' }]),
  { '@type': 'Blog', name: 'Blog da TMJL Marketing Local', url: `${site.url}/blog/`, publisher: { '@id': `${site.url}/#empresa` }, blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${site.url}/blog/${p.id}/`, datePublished: p.data.pubDate.toISOString() })) },
];
---
<Base title="Blog: Google Meu Negócio, sites e fotos 360° | TMJL" description="Guias práticos sobre Google Meu Negócio, SEO local, avaliações, sites profissionais e fotos 360°, escritos por Jefferson Lourenço, da TMJL Marketing Local." schema={schema}>
  <PageHead crumbs={[{ name: 'Blog', path: '/blog/' }]} title="Blog" lead="Guias práticos para a sua empresa aparecer melhor no Google." />
  <section class="section" aria-label="Artigos">
    <div class="container">
      <ul class="posts" role="list">
        {posts.map((p, i) => (
          <li>
            <a href={`/blog/${p.id}/`} class="post">
              {p.data.image && <img src={p.data.image} width="1400" height="752" alt="" loading={i < 2 ? 'eager' : 'lazy'} />}
              <span class="post__body">
                <time class="caption" datetime={(p.data.updatedDate ?? p.data.pubDate).toISOString()}>{fmt(p.data.updatedDate ?? p.data.pubDate)}</time>
                <span class="post__t">{p.data.title}</span>
                <span class="post__d">{p.data.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Closing />
</Base>
<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; border-top: var(--rule-hair) solid var(--color-ink); }
  .post { display: grid; gap: var(--space-lg); padding-block: var(--space-xl); border-bottom: var(--rule-hair) solid var(--color-rule); text-decoration: none; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 52rem) { .post { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-2xl); align-items: center; } }
  .post img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; border-radius: var(--radius-card); box-shadow: 0 0 0 1px var(--color-rule); }
  .post__body { display: grid; gap: var(--space-sm); }
  .post__t { font: 600 var(--text-2xl)/1.15 var(--font-display); letter-spacing: var(--tracking-display); color: var(--color-ink); text-wrap: balance; }
  .post:hover .post__t { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .post__d { color: var(--color-muted); max-width: 62ch; }
</style>
