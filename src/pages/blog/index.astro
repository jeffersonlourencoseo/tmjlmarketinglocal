---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("pt-BR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
}
---

<Layout
  title="Blog | TMJL Marketing Local — Google Meu Negócio Rio de Janeiro"
  description="Dicas, estratégias e novidades sobre Google Meu Negócio, SEO local e ranqueamento no Rio de Janeiro.">
  <Header />
  <main class="pt-24 bg-secondary">
    <section class="relative py-28 lg:py-36 bg-primary overflow-hidden">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent/10 rounded-full blur-[140px] -translate-y-1/2 translate-x-1/3"></div>
      </div>

      <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl">
          <p class="text-accent font-semibold tracking-[0.2em] uppercase text-sm mb-6">
            Blog
          </p>
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-8">
            Conteúdo para quem quer ser encontrado
          </h1>
          <p class="text-lg md:text-xl text-white/90 max-w-2xl leading-relaxed">
            Artigos práticos sobre Google Meu Negócio, SEO local e estratégias de crescimento para empresas do Rio de Janeiro.
          </p>
        </div>
      </div>
    </section>

    <section class="py-28 lg:py-36">
      <div class="container mx-auto px-6 lg:px-12">
        <div class="grid md:grid-cols-2 gap-10 lg:gap-12">
          {posts.map((post) => (
            <article class="group p-10 lg:p-12 bg-surface rounded-2xl border border-gold hover:border-accent/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5 flex flex-col">
              <div class="flex flex-wrap gap-2 mb-6">
                {post.data.tags.map((tag) => (
                  <span class="px-3 py-1 bg-primary/5 text-primary text-xs font-semibold uppercase tracking-wider rounded-full">
                    {tag}
                  </span>
                ))}
              </div>

              <p class="text-sm text-muted mb-3">{formatDate(post.data.pubDate)}</p>

              <h2 class="font-display text-2xl lg:text-3xl font-bold text-primary mb-4">
                <a href={`/blog/${post.id}/`} class="hover:text-accent transition-colors duration-200">
                  {post.data.title}
                </a>
              </h2>

              <p class="text-muted leading-relaxed mb-8 flex-grow">
                {post.data.description}
              </p>

              <a
                href={`/blog/${post.id}/`}
                class="inline-flex items-center gap-2 text-accent font-semibold group-hover:gap-3 group-hover:scale-105 active:scale-95 transition-all duration-200"
              >
                Ler artigo
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
