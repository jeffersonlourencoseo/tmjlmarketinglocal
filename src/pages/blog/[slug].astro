---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Closing from '../../components/Closing.astro';
import Icon from '../../components/Icon.astro';
import { breadcrumb } from '../../data/schema';
import { site, wa } from '../../data/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content, headings } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const path = `/blog/${post.id}/`;
const toc = headings.filter((h) => h.depth === 2);
const servicos: Record<string, string> = { '/google-meu-negocio/': 'otimização de Google Meu Negócio', '/criacao-de-sites/': 'criação de sites profissionais', '/fotos-360/': 'fotos 360° e tour virtual' };
const servicoNome = d.servico ? servicos[d.servico] : undefined;
const schema = [
  breadcrumb([{ name: 'Blog', path: '/blog/' }, { name: d.title, path }]),
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@id': `${site.url}/#jefferson` },
    publisher: { '@id': `${site.url}/#empresa` },
    mainEntityOfPage: `${site.url}${path}`,
    image: d.image ? `${site.url}${d.image}` : `${site.url}/og-image.jpg`,
    keywords: d.tags.join(', '),
    inLanguage: 'pt-BR',
  },
];
---
<Base title={(d.title + ' | TMJL').length <= 60 ? `${d.title} | TMJL` : d.title} description={d.description} image={d.image} type="article" schema={schema}>
  <article>
    <header class="art-head">
      <div class="container">
        <nav aria-label="Você está em" class="crumbs"><a href="/">Início</a> / <a href="/blog/">Blog</a></nav>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        <p class="by">
          <img src="/img/jefferson-lourenco.webp" width="900" height="837" alt="" />
          <span>Por <a href="/quem-somos/">{d.author}</a><br /><time class="caption" datetime={(d.updatedDate ?? d.pubDate).toISOString()}>{d.updatedDate ? `Atualizado em ${fmt(d.updatedDate)}` : fmt(d.pubDate)}</time></span>
        </p>
      </div>
    </header>
    {d.image && <div class="container"><img class="art-cover" src={d.image} width="1400" height="752" alt="" /></div>}
    <div class="container art-body">
      {toc.length > 2 && (
        <aside class="toc" aria-label="Neste artigo">
          <p class="caption">Neste artigo</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </aside>
      )}
      <div class="article">
        <Content />
        <div class="art-cta entry">
          <div class="art-cta__head">{servicoNome ? `Serviço: ${servicoNome}` : 'Fale comigo'}</div>
          <div class="art-cta__body notebook">
            <p><strong>Quer que eu cuide disso para você?</strong> Me manda o nome da empresa no WhatsApp e eu te digo o que fazer primeiro.</p>
            <div class="actions">
              <a class="btn btn--primary" href={wa(servicoNome ?? 'os serviços da TMJL')} target="_blank" rel="noopener" data-wa="artigo"><Icon name="whatsapp" /> Chamar no WhatsApp</a>
              {d.servico && <a class="more" href={d.servico}>Ver o serviço</a>}
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
  <Closing />
</Base>
<style>
  .art-head { padding-block: var(--space-lg) var(--space-2xl); }
  .crumbs { font-size: var(--text-sm); color: var(--color-muted); margin-bottom: var(--space-2xl); }
  .crumbs a { color: var(--color-muted); text-decoration: none; }
  .art-head h1 { font-size: var(--text-display-s); max-width: 22ch; text-wrap: balance; margin-bottom: var(--space-lg); }
  .art-head .lead { margin-bottom: var(--space-lg); }
  .by { display: flex; align-items: center; gap: var(--space-md); font-size: var(--text-sm); }
  .by img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: 50% 15%; box-shadow: 0 0 0 1px var(--color-ink); }
  .art-cover { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; object-position: top; border-radius: var(--radius-card); box-shadow: 0 0 0 1px var(--color-rule); }
  .art-body { display: grid; gap: var(--space-2xl); grid-template-columns: minmax(0, 1fr); padding-block: var(--space-2xl) var(--section-gap-s); }
  @media (min-width: 64rem) { .art-body { grid-template-columns: minmax(0, 3fr) minmax(0, 8fr); gap: var(--space-3xl); } }
  .toc { align-self: start; border-top: var(--rule-hair) solid var(--color-ink); padding-top: var(--space-md); }
  @media (min-width: 64rem) { .toc { position: sticky; top: var(--space-3xl); } }
  .toc ol { list-style: none; margin: var(--space-sm) 0 0; padding: 0; display: grid; gap: var(--space-xs); font-size: var(--text-sm); }
  .toc a { color: var(--color-ink-2); text-decoration: none; }
  .toc a:hover { text-decoration: underline; text-decoration-color: var(--color-accent); }
  .article { max-width: 68ch; font-size: 1.0625rem; line-height: 1.75; color: var(--color-ink-2); }
  .article :global(h2) { font-size: var(--text-2xl); margin: var(--space-2xl) 0 var(--space-md); max-width: 28ch; overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
  .article :global(h3) { font-size: var(--text-title); margin: var(--space-xl) 0 var(--space-sm); overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
  .article :global(p) { margin-bottom: var(--space-md); max-width: none; }
  .article :global(ul), .article :global(ol) { padding-left: var(--space-lg); margin-bottom: var(--space-md); display: grid; gap: var(--space-xs); }
  .article :global(blockquote) { margin: var(--space-xl) 0; padding: var(--space-lg); background: var(--color-paper-2); border-left: 3px solid var(--color-ink); }
  .article :global(blockquote p:last-child) { margin-bottom: 0; }
  .article :global(table) { width: 100%; border-collapse: collapse; font-size: var(--text-sm); margin-block: var(--space-lg); display: block; overflow-x: auto; }
  .article :global(th), .article :global(td) { text-align: left; padding: var(--space-sm) var(--space-md) var(--space-sm) 0; border-bottom: var(--rule-hair) solid var(--color-rule); }
  .article :global(a) { color: var(--color-ink); text-decoration-color: var(--color-accent); overflow-wrap: anywhere; }
  .article :global(strong) { color: var(--color-ink); }
  .art-cta { margin-top: var(--space-2xl); }
  .art-cta__head { padding: var(--space-sm) var(--space-lg); background: var(--color-ink); color: var(--color-on-ink); font-weight: 500; font-size: var(--text-sm); }
  .art-cta__body { display: grid; gap: var(--space-lg); justify-items: start; padding: var(--space-lg); }
  .art-cta__body p { margin: 0 !important; }
</style>
