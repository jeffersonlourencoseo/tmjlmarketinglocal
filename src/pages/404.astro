---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Página não encontrada | TMJL" description="Esta página não existe ou mudou de endereço." noindex>
  <section class="container nf">
    <p class="nf__n tnum" aria-hidden="true">404</p>
    <h1>Essa página saiu do mapa</h1>
    <p class="lead">O endereço pode ter mudado. Tente um destes caminhos:</p>
    <div class="actions">
      <a class="btn btn--gold" href="/">Ir para o início</a>
      <a class="btn" href="/google-meu-negocio/">Google Meu Negócio</a>
      <a class="more" href="/portfolio/">Portfólio <Icon name="arrow" /></a>
    </div>
  </section>
</Base>
<style>
  .nf { padding-block: var(--space-3xl) var(--section-gap-s); display: grid; gap: var(--space-lg); justify-items: start; }
  .nf__n { font: 600 clamp(6rem, 16vw, 12rem)/0.85 var(--font-display); letter-spacing: var(--tracking-display); color: var(--color-ink); }
</style>
