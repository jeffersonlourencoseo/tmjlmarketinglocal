---
interface Props { faqs: { q: string; a: string }[]; title?: string; intro?: string }
const { faqs, title = 'Perguntas que eu mais recebo', intro } = Astro.props;
---
<section class="section rule-top" aria-labelledby="faq-t">
  <div class="container faqgrid">
    <div>
      <h2 id="faq-t">{title}</h2>
      {intro && <p class="muted" style="margin-top: var(--space-md)">{intro}</p>}
    </div>
    <div class="faq">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary><span>{f.q}</span><span class="pm" aria-hidden="true"></span></summary>
          <div class="answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faqgrid { display: grid; gap: var(--space-xl); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) { .faqgrid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--gap-columns); } .faqgrid > div:first-child { position: sticky; top: var(--space-3xl); align-self: start; } }
</style>
