---
import { siteConfig } from "../data/config";

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-primary text-white pt-28 pb-14">
  <div class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-surface-dark to-primary"></div>

  <div class="container mx-auto px-6 lg:px-12 relative">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-14 lg:gap-12 mb-20">
      <div class="lg:col-span-2">
        <h3 class="font-display text-3xl font-bold mb-5 text-white">
          TMJL <span class="text-accent">Marketing Local</span>
        </h3>
        <p class="text-white/80 max-w-md leading-relaxed">
          Especialistas em Google Meu Negócio no Rio de Janeiro. Criamos e otimizamos perfis locais para ranqueamento orgânico, reputação e geração real de clientes.
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-accent mb-6">Navegação</h4>
        <ul class="space-y-4">
          <li><a href="/" class="text-white/80 hover:text-accent transition-colors duration-200 inline-block hover:translate-x-1">Início</a></li>
          <li><a href="/servicos/" class="text-white/80 hover:text-accent transition-colors duration-200 inline-block hover:translate-x-1">Serviços</a></li>
          <li><a href="/fotos-360/" class="text-white/80 hover:text-accent transition-colors duration-200 inline-block hover:translate-x-1">Fotos 360°</a></li>
          <li><a href="/blog/" class="text-white/80 hover:text-accent transition-colors duration-200 inline-block hover:translate-x-1">Blog</a></li>
          <li><a href="/sobre/" class="text-white/80 hover:text-accent transition-colors duration-200 inline-block hover:translate-x-1">Sobre</a></li>
          <li><a href="/contato/" class="text-white/80 hover:text-accent transition-colors duration-200 inline-block hover:translate-x-1">Contato</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-accent mb-6">Contato</h4>
        <ul class="space-y-5 text-white/80">
          <li>
            <a href={`https://wa.me/${siteConfig.contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors duration-200">{siteConfig.contact.phone}</a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-accent transition-colors duration-200">{siteConfig.contact.email}</a>
          </li>
          <li class="leading-relaxed text-sm">{siteConfig.contact.address}</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-10 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-white/70 text-sm">
        © {currentYear} TMJL Marketing Local. Todos os direitos reservados.
      </p>
      <div class="flex items-center gap-6 text-sm text-white/70">
        <a href="/privacidade/" class="hover:text-accent transition-colors duration-200">Privacidade</a>
        <a href="/termos/" class="hover:text-accent transition-colors duration-200">Termos</a>
      </div>
    </div>
  </div>
</footer>
