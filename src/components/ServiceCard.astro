---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<article class="group relative h-full p-10 lg:p-12 bg-surface rounded-2xl border border-gold hover:border-accent/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5 flex flex-col">
  <div class="absolute top-8 right-8 font-display text-5xl lg:text-6xl text-accent/10 group-hover:text-accent/20 transition-colors duration-300">
    {number}
  </div>

  <div class="relative flex flex-col flex-grow">
    <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-300">
      <span class="text-accent font-display text-xl font-bold">{number}</span>
    </div>

    <h3 class="font-display text-2xl lg:text-3xl font-bold text-primary mb-5">
      {title}
    </h3>

    <p class="text-muted leading-relaxed mb-10 flex-grow">
      {description}
    </p>

    <a
      href="/servicos/"
      class="inline-flex items-center gap-2 text-accent font-semibold group-hover:gap-3 group-hover:scale-105 active:scale-95 transition-all duration-200"
    >
      Conhecer serviço
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</article>
