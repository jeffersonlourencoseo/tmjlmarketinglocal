---
import { siteConfig } from "../data/config";

const phone = siteConfig.contact.whatsapp;
const email = siteConfig.contact.email;
---

<form
  action={`https://formsubmit.co/${email}`}
  method="POST"
  class="space-y-6"
  aria-label="Formulário de contato">
  <input type="hidden" name="_subject" value="Novo contato pelo site TMJL Marketing Local" />
  <input type="hidden" name="_captcha" value="false" />

  <div class="grid md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <label for="name" class="text-sm font-semibold text-primary">Nome</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-5 py-4 bg-white border border-gold rounded-xl text-primary placeholder:text-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all hover:border-accent/30"
        placeholder="Seu nome completo"
      />
    </div>

    <div class="space-y-2">
      <label for="phone" class="text-sm font-semibold text-primary">Telefone / WhatsApp</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        class="w-full px-5 py-4 bg-white border border-gold rounded-xl text-primary placeholder:text-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all hover:border-accent/30"
        placeholder="(21) 00000-0000"
      />
    </div>
  </div>

  <div class="space-y-2">
    <label for="email" class="text-sm font-semibold text-primary">E-mail</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-5 py-4 bg-white border border-gold rounded-xl text-primary placeholder:text-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all hover:border-accent/30"
      placeholder="seu@email.com"
    />
  </div>

  <div class="space-y-2">
    <label for="service" class="text-sm font-semibold text-primary">Serviço de interesse</label>
    <select
      id="service"
      name="service"
      class="w-full px-5 py-4 bg-white border border-gold rounded-xl text-primary focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all hover:border-accent/30"
    >
      <option value="">Selecione uma opção</option>
      <option value="criacao">Criação de Perfil</option>
      <option value="otimizacao">Otimização Local</option>
      <option value="avaliacoes">Reputação e Avaliações</option>
      <option value="pacote">Pacote completo</option>
    </select>
  </div>

  <div class="space-y-2">
    <label for="message" class="text-sm font-semibold text-primary">Mensagem</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      class="w-full px-5 py-4 bg-white border border-gold rounded-xl text-primary placeholder:text-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all hover:border-accent/30 resize-y"
      placeholder="Conte um pouco sobre o seu negócio e o que você precisa..."
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full px-8 py-5 bg-accent text-primary font-bold rounded-full hover:bg-accent-light hover:scale-[1.02] active:scale-95 transition-all duration-200 hover:shadow-[0_0_40px_-10px_rgba(201,162,39,0.5)]"
  >
    Enviar mensagem
  </button>

  <p class="text-center text-sm text-muted">
    Ou prefere falar pelo WhatsApp?
    <a href={`https://wa.me/${phone}`} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-primary font-semibold transition-colors duration-200 hover:underline">
      Clique aqui
    </a>
  </p>
</form>
