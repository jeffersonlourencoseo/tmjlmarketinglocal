---
/**
 * Assinatura do tema Furrow: o bairro desenhado como mapa de levantamento (canvas, gerado no load),
 * com as ações de clientes fixadas onde aconteceram e a caderneta do perfil aberta por cima.
 * Sem script: o papel, os pinos e a caderneta continuam visíveis.
 */
---
<figure class="sm" data-survey aria-label="Mapa ilustrativo do bairro com ligações, rotas e mensagens chegando ao perfil da empresa no Google, e o resumo dos perfis que eu gerencio">
  <canvas class="sm__canvas" aria-hidden="true"></canvas>

  <svg class="sm__route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path d="M18 22 C 26 28, 32 32, 38 35 S 45 38, 47 40" />
  </svg>

  <ul class="sm__pins" aria-hidden="true">
    <li class="pin pin--disc" style="--x: 18%; --y: 22%; --i: 0"><span class="pin__m"></span><span class="pin__t">Rota pedida</span></li>
    <li class="pin pin--diamond" style="--x: 70%; --y: 18%; --i: 1"><span class="pin__m"></span><span class="pin__t">Ligação</span></li>
    <li class="pin pin--tri" style="--x: 30%; --y: 66%; --i: 2"><span class="pin__m"></span><span class="pin__t">WhatsApp</span></li>
    <li class="pin pin--disc pin--open" style="--x: 47%; --y: 40%; --i: 3"><span class="pin__m"></span><span class="pin__t">Sua empresa</span></li>
  </ul>

  <span class="sm__place" style="--x: 8%; --y: 44%; --r: -8deg">Penha</span>
  <span class="sm__place" style="--x: 60%; --y: 34%; --r: 6deg">Irajá</span>
  <span class="sm__place" style="--x: 64%; --y: 84%; --r: -3deg">Av. Brasil</span>

  <figcaption class="entry sm__card">
    <div class="sm__head">
      <span><span class="sm__dot"></span> Perfil da sua empresa</span>
      <span>Diagnóstico</span>
    </div>
    <div class="sm__cells notebook">
      <div><span class="sm__label">Categoria</span><span class="sm__val">Correta</span></div>
      <div><span class="sm__label">Fotos</span><span class="sm__val">Geotagueadas</span></div>
      <div><span class="sm__label">Posts</span><span class="sm__val">Toda semana</span></div>
      <div><span class="sm__label">Avaliações</span><span class="sm__val">Respondidas</span></div>
    </div>
    <div class="sm__foot"><span class="sm__chip">Perfil em dia</span><span class="caption"><span class="num">10</span> pontos analisados</span></div>
  </figcaption>
</figure>

<script>
  type Pt = [number, number];
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

  function rng(seed: number) { return () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296); }
  function noise2(seed: number) {
    const r = rng(seed), g: number[] = [];
    for (let i = 0; i < 64 * 64; i++) g.push(r());
    const at = (x: number, y: number) => g[((y & 63) * 64) + (x & 63)];
    const sm = (t: number) => t * t * (3 - 2 * t);
    const v = (x: number, y: number) => {
      const xi = Math.floor(x), yi = Math.floor(y), xf = sm(x - xi), yf = sm(y - yi);
      const a = at(xi, yi), b = at(xi + 1, yi), c = at(xi, yi + 1), d = at(xi + 1, yi + 1);
      return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf;
    };
    return (x: number, y: number) => v(x, y) * 0.6 + v(x * 2.1, y * 2.1) * 0.28 + v(x * 4.3, y * 4.3) * 0.12;
  }

  function draw(fig: HTMLElement) {
    const cv = fig.querySelector('canvas')!;
    const w = fig.clientWidth, h = fig.clientHeight, dpr = Math.min(2, devicePixelRatio || 1);
    cv.width = w * dpr; cv.height = h * dpr; cv.style.width = w + 'px'; cv.style.height = h + 'px';
    const c = cv.getContext('2d')!; c.setTransform(dpr, 0, 0, dpr, 0, 0);
    const paper = css('--color-paper-2'), contour = css('--color-contour'), water = css('--color-water'), hedge = css('--color-hedge'), ink = css('--color-ink'), accent = css('--color-accent'), grid = css('--color-grid');
    c.fillStyle = paper; c.fillRect(0, 0, w, h);

    // curvas de nível por marching squares
    const n = noise2(7), cell = 10, cols = Math.ceil(w / cell) + 1, rows = Math.ceil(h / cell) + 1, sc = 0.012;
    const f: number[][] = [];
    for (let j = 0; j < rows; j++) { f[j] = []; for (let i = 0; i < cols; i++) f[j][i] = n(i * cell * sc, j * cell * sc); }
    const levels = 16;
    for (let L = 1; L < levels; L++) {
      const t = L / levels;
      c.beginPath(); c.strokeStyle = contour; c.lineWidth = L % 5 === 0 ? 1.4 : 0.6; c.globalAlpha = L % 5 === 0 ? 0.75 : 0.45;
      for (let j = 0; j < rows - 1; j++) for (let i = 0; i < cols - 1; i++) {
        const a = f[j][i], b = f[j][i + 1], d = f[j + 1][i], e = f[j + 1][i + 1];
        const x = i * cell, y = j * cell, pts: Pt[] = [];
        const lerp = (p: number, q: number) => (t - p) / (q - p || 1e-6);
        if ((a < t) !== (b < t)) pts.push([x + lerp(a, b) * cell, y]);
        if ((b < t) !== (e < t)) pts.push([x + cell, y + lerp(b, e) * cell]);
        if ((d < t) !== (e < t)) pts.push([x + lerp(d, e) * cell, y + cell]);
        if ((a < t) !== (d < t)) pts.push([x, y + lerp(a, d) * cell]);
        if (pts.length >= 2) { c.moveTo(pts[0][0], pts[0][1]); c.lineTo(pts[1][0], pts[1][1]); }
        if (pts.length === 4) { c.moveTo(pts[2][0], pts[2][1]); c.lineTo(pts[3][0], pts[3][1]); }
      }
      c.stroke();
    }
    c.globalAlpha = 1;

    // rio
    c.strokeStyle = water; c.lineWidth = 3; c.lineCap = 'round';
    c.beginPath(); c.moveTo(-10, h * 0.78); c.bezierCurveTo(w * 0.25, h * 0.7, w * 0.45, h * 0.95, w * 0.7, h * 0.88); c.bezierCurveTo(w * 0.85, h * 0.84, w * 0.95, h * 0.9, w + 10, h * 0.86); c.stroke();

    // ruas: avenida larga e duas ruas
    const road = (pts: Pt[], wd: number) => { c.lineWidth = wd + 2; c.strokeStyle = ink; c.beginPath(); pts.forEach((p, k) => k ? c.lineTo(p[0], p[1]) : c.moveTo(p[0], p[1])); c.stroke(); c.lineWidth = wd; c.strokeStyle = paper; c.stroke(); };
    road([[-10, h * 0.48], [w * 0.4, h * 0.42], [w + 10, h * 0.3]], 7);
    road([[w * 0.55, -10], [w * 0.5, h * 0.45], [w * 0.42, h + 10]], 5);
    road([[-10, h * 0.9], [w + 10, h * 0.8]], 9);

    // cercas pontilhadas
    c.setLineDash([2, 5]); c.strokeStyle = hedge; c.lineWidth = 1.6;
    [[[w * 0.08, h * 0.08], [w * 0.36, h * 0.12], [w * 0.4, h * 0.36], [w * 0.1, h * 0.4]], [[w * 0.62, h * 0.06], [w * 0.92, h * 0.1], [w * 0.88, h * 0.26]], [[w * 0.12, h * 0.56], [w * 0.36, h * 0.52], [w * 0.38, h * 0.74]]].forEach((poly) => { c.beginPath(); (poly as Pt[]).forEach((p, k) => k ? c.lineTo(p[0], p[1]) : c.moveTo(p[0], p[1])); c.stroke(); });
    c.setLineDash([]);

    // quadras com hachura
    const hatch = (x: number, y: number, bw: number, bh: number) => {
      c.save(); c.beginPath(); c.rect(x, y, bw, bh); c.clip();
      c.strokeStyle = ink; c.globalAlpha = 0.5; c.lineWidth = 0.7;
      for (let k = -bh; k < bw; k += 5) { c.beginPath(); c.moveTo(x + k, y + bh); c.lineTo(x + k + bh, y); c.stroke(); }
      c.restore(); c.globalAlpha = 1; c.strokeStyle = ink; c.lineWidth = 1; c.strokeRect(x, y, bw, bh);
    };
    hatch(w * 0.6, h * 0.42, w * 0.06, h * 0.05); hatch(w * 0.68, h * 0.4, w * 0.04, h * 0.07); hatch(w * 0.2, h * 0.26, w * 0.05, h * 0.04); hatch(w * 0.72, h * 0.6, w * 0.07, h * 0.05);

    // o terreno da empresa, contornado em laranja
    c.strokeStyle = accent; c.lineWidth = 3; c.lineJoin = 'round';
    c.beginPath(); c.moveTo(w * 0.42, h * 0.35); c.lineTo(w * 0.53, h * 0.33); c.lineTo(w * 0.55, h * 0.45); c.lineTo(w * 0.44, h * 0.47); c.closePath(); c.stroke();

    // grão do papel e duas dobras (só no mapa)
    const r = rng(3); c.fillStyle = ink;
    for (let k = 0; k < (w * h) / 900; k++) { c.globalAlpha = 0.04 + r() * 0.05; c.fillRect(r() * w, r() * h, 1, 1); }
    c.globalAlpha = 1;
    [[w * 0.5, 0, w * 0.5, h], [0, h * 0.5, w, h * 0.5]].forEach(([x1, y1, x2, y2]) => {
      const g = x1 === x2 ? c.createLinearGradient(x1 - 6, 0, x1 + 6, 0) : c.createLinearGradient(0, y1 - 6, 0, y1 + 6);
      g.addColorStop(0, 'transparent'); g.addColorStop(0.5, grid); g.addColorStop(1, 'transparent');
      c.fillStyle = g; x1 === x2 ? c.fillRect(x1 - 6, 0, 12, h) : c.fillRect(0, y1 - 6, w, 12);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-survey]').forEach((fig) => {
    const go = () => draw(fig);
    go();
    let t = 0; new ResizeObserver(() => { cancelAnimationFrame(t); t = requestAnimationFrame(go); }).observe(fig);
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { fig.classList.add('is-in'); io.disconnect(); } }), { threshold: 0.25 });
    io.observe(fig);
  });
</script>

<style>
  .sm { position: relative; margin: 0; min-height: 560px; height: 100%; border-radius: var(--radius-card); overflow: hidden; background: var(--color-paper-3); box-shadow: 0 0 0 1px var(--color-rule); }
  .sm__canvas { position: absolute; inset: 0; display: block; }
  .sm__route { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .sm__route path { fill: none; stroke: var(--color-ink); stroke-width: 0.35; stroke-dasharray: 1.2 1.2; vector-effect: non-scaling-stroke; }
  .sm__pins { list-style: none; margin: 0; padding: 0; }
  .pin { position: absolute; left: var(--x); top: var(--y); display: flex; align-items: center; gap: var(--space-xs); transform: translate(-7px, -7px); }
  .pin__m { width: 14px; height: 14px; background: var(--color-ink); box-shadow: 0 0 0 3px var(--color-paper-2); flex-shrink: 0; }
  .pin--disc .pin__m { border-radius: 50%; }
  .pin--diamond .pin__m { transform: rotate(45deg) scale(0.85); }
  .pin--tri .pin__m { background: none; box-shadow: none; width: 0; height: 0; border-left: 8px solid transparent; border-right: 8px solid transparent; border-bottom: 14px solid var(--color-ink); }
  .pin--open .pin__m { background: var(--color-accent); width: 18px; height: 18px; box-shadow: 0 0 0 3px var(--color-paper-2), 0 0 0 4px var(--color-ink); }
  .pin__t { padding: var(--space-2xs) var(--space-xs); border-radius: var(--radius-pill); background: var(--color-ink); color: var(--color-on-ink); font: 500 var(--text-xs)/1.2 var(--font-body); white-space: nowrap; }
  .pin--open .pin__t { background: var(--color-accent); color: var(--color-accent-ink); }
  .sm__place { position: absolute; left: var(--x); top: var(--y); rotate: var(--r); font: 500 var(--text-sm)/1 var(--font-body); color: var(--color-muted); pointer-events: none; }

  .js .sm:not(.is-in) .pin { opacity: 0; translate: 0 -10px; }
  .js .sm .pin { transition: opacity 400ms var(--ease-out), translate 400ms var(--ease-out); transition-delay: calc(200ms + var(--i) * 180ms); }
  .js .sm:not(.is-in) .sm__route path { stroke-dashoffset: 40; opacity: 0; }
  .js .sm .sm__route path { transition: opacity 600ms var(--ease-out) 700ms; }
  .js .sm:not(.is-in) .sm__card { opacity: 0; transform: translateY(12px); }
  .js .sm .sm__card { transition: opacity 500ms var(--ease-out) 900ms, transform 500ms var(--ease-out) 900ms; }

  @media (prefers-reduced-motion: reduce) { .js .sm:not(.is-in) .pin, .js .sm:not(.is-in) .sm__card, .js .sm:not(.is-in) .sm__route path { opacity: 1; translate: none; transform: none; } }
  .sm__card { position: absolute; right: var(--space-lg); bottom: var(--space-lg); width: min(340px, calc(100% - 2 * var(--space-lg))); display: grid; }
  .sm__head { display: flex; justify-content: space-between; gap: var(--space-md); padding: var(--space-sm) var(--space-md); background: var(--color-ink); color: var(--color-on-ink); font: 500 var(--text-sm)/1.3 var(--font-body); }
  .sm__head .num { font-size: var(--text-xs); color: var(--color-on-ink-muted); }
  .sm__dot { display: inline-block; width: 8px; height: 8px; margin-right: var(--space-2xs); border-radius: 50%; background: var(--color-accent); }
  .sm__big { display: grid; gap: var(--space-2xs); padding: var(--space-md); border-bottom: var(--rule-hair) solid var(--color-ink); }
  .sm__label { font-size: var(--text-xs); font-weight: 500; color: var(--color-muted); }
  .sm__fig { font: 600 2.75rem/1 var(--font-display); letter-spacing: var(--tracking-display); color: var(--color-ink); }
  .sm__cells { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sm__cells > div { display: grid; gap: var(--space-2xs); padding: var(--space-sm) var(--space-md); border-bottom: var(--rule-hair) solid var(--color-ink); }
  .sm__cells > div:nth-child(even) { border-left: var(--rule-hair) solid var(--color-ink); }
  .sm__val { font: 600 var(--text-lg)/1.1 var(--font-display); letter-spacing: var(--tracking-display); color: var(--color-ink); }
  .sm__foot { display: flex; justify-content: space-between; align-items: center; padding: var(--space-sm) var(--space-md); background: var(--color-paper-2); }
  .sm__chip { padding: var(--space-2xs) var(--space-xs); border-radius: var(--radius-pill); background: var(--color-green-soft); color: var(--color-green); font: 500 var(--text-xs)/1.2 var(--font-body); }

  @media (max-width: 40rem) {
    .sm { min-height: 520px; }
    .sm__card { left: var(--space-md); right: var(--space-md); bottom: var(--space-md); width: auto; }
    .sm__place { display: none; }
  }
</style>
