---
import type { Pano } from '../data/portfolio';
import Icon from './Icon.astro';
interface Props {
  pano: Pano;
  start?: number; // índice da cena inicial
  eager?: boolean; // em telas com mouse, já liga a foto 360° ao aparecer
  showScenes?: boolean;
  caption?: string;
  class?: string;
  priority?: boolean;
}
const { pano, start = 0, eager = false, showScenes = true, caption, class: cls = '', priority = false } = Astro.props;
const base = `/panoramas/${pano.id}`;
const scenes = pano.scenes.map((s, i) => ({ id: s, name: pano.sceneNames?.[i] ?? `Ambiente ${i + 1}`, src: `${base}/${s}.jpg` }));
const first = scenes[start] ?? scenes[0];
const poster = `${base}/cards/${first.id}-poster.webp`;
---
<figure class={`pano ${cls}`} data-pano data-eager={eager ? '1' : undefined} data-scenes={JSON.stringify(scenes)} data-first={first.id}>
  <div class="pano__stage">
    <img class="pano__poster" src={poster} width="1400" height="752" alt={`${pano.name}: ${first.name.toLowerCase()} em foto 360°`} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
    <div class="pano__view" data-view></div>
    <button class="pano__start" type="button" data-start>
      <Icon name="rotate" /> <span>Girar em 360°</span>
    </button>
    <button class="pano__fs" type="button" data-fs hidden aria-label="Tela cheia"><Icon name="expand" /></button>
    <p class="pano__hint" data-hint hidden>Arraste para olhar em volta</p>
  </div>
  {(showScenes && scenes.length > 1) && (
    <div class="pano__scenes" role="group" aria-label={`Ambientes de ${pano.name}`}>
      {scenes.map((s) => <button type="button" data-scene={s.id} aria-pressed={s.id === first.id ? 'true' : 'false'}>{s.name}</button>)}
    </div>
  )}
  {caption && <figcaption class="caption" set:html={caption} />}
</figure>

<script>
  let loader: Promise<void> | null = null;
  function loadLib() {
    if (loader) return loader;
    loader = new Promise((res, rej) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet'; css.href = '/vendor/pannellum/pannellum.css';
      document.head.appendChild(css);
      const s = document.createElement('script');
      s.src = '/vendor/pannellum/pannellum.js'; s.onload = () => res(); s.onerror = rej;
      document.head.appendChild(s);
    });
    return loader;
  }
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

  document.querySelectorAll<HTMLElement>('[data-pano]').forEach((fig) => {
    const scenes = JSON.parse(fig.dataset.scenes || '[]') as { id: string; name: string; src: string }[];
    const view = fig.querySelector<HTMLElement>('[data-view]')!;
    const startBtn = fig.querySelector<HTMLButtonElement>('[data-start]')!;
    const fs = fig.querySelector<HTMLButtonElement>('[data-fs]')!;
    const hint = fig.querySelector<HTMLElement>('[data-hint]')!;
    const sceneBtns = fig.querySelectorAll<HTMLButtonElement>('[data-scene]');
    let viewer: any = null;
    let current = fig.dataset.first!;

    async function init() {
      if (viewer) return;
      startBtn.disabled = true;
      startBtn.querySelector('span')!.textContent = 'Carregando…';
      try { await loadLib(); } catch { startBtn.disabled = false; startBtn.querySelector('span')!.textContent = 'Tentar de novo'; return; }
      const conf: Record<string, any> = {};
      scenes.forEach((s) => (conf[s.id] = { type: 'equirectangular', panorama: s.src, title: '' }));
      viewer = (window as any).pannellum.viewer(view, {
        default: { firstScene: current, autoLoad: true, showControls: false, mouseZoom: false, keyboardZoom: false, compass: false, hfov: 105, minHfov: 60, maxHfov: 120, autoRotate: reduce ? 0 : -1.6, autoRotateInactivityDelay: 4000, sceneFadeDuration: reduce ? 0 : 500 },
        scenes: conf,
      });
      viewer.on('load', () => {
        fig.classList.add('is-live');
        startBtn.hidden = true; fs.hidden = false; hint.hidden = false;
        setTimeout(() => (hint.hidden = true), 3500);
      });
      viewer.on('error', () => { startBtn.disabled = false; startBtn.hidden = false; startBtn.querySelector('span')!.textContent = 'Não carregou. Tentar de novo'; viewer?.destroy?.(); viewer = null; });
    }

    startBtn.addEventListener('click', init);
    fs.addEventListener('click', () => viewer?.toggleFullscreen());
    sceneBtns.forEach((b) => b.addEventListener('click', async () => {
      current = b.dataset.scene!;
      sceneBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const img = fig.querySelector<HTMLImageElement>('.pano__poster');
      if (!viewer) { if (img) img.src = img.src.replace(/\/cards\/[^/]+-poster\.webp$/, `/cards/${current}-poster.webp`); await init(); }
      else viewer.loadScene(current);
    }));

    if (fig.dataset.eager && fine) {
      const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { io.disconnect(); init(); } }, { rootMargin: '200px' });
      io.observe(fig);
    }
  });
</script>

<style>
  .pano { margin: 0; display: grid; gap: var(--space-md); min-width: 0; }
  .pano__stage { position: relative; overflow: hidden; background: var(--color-paper-3); aspect-ratio: 16 / 10; border-radius: var(--radius-card); box-shadow: 0 0 0 1px var(--color-rule); }
  .pano--tall .pano__stage { aspect-ratio: auto; height: clamp(360px, 64dvh, 720px); }
  .pano__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity var(--dur-long) var(--ease-out); }
  .pano__view { position: absolute; inset: 0; }
  .pano.is-live .pano__poster { opacity: 0; }
  .pano__start { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 48px; padding: 0 var(--space-lg); border: var(--rule-hair) solid var(--color-ink); border-radius: var(--radius-pill); background: var(--color-paper-2); color: var(--color-ink); font: 500 var(--text-md)/1 var(--font-body); cursor: pointer; box-shadow: var(--shadow-lift); transition: background-color var(--dur-short) var(--ease-out); }
  .pano__start:hover { background: var(--color-accent); }
  .pano__start:active { transform: translate(-50%, calc(-50% + 1px)); }
  .pano__start :global(svg) { width: 20px; height: 20px; }
  .pano__start[disabled] { cursor: progress; opacity: 0.8; }
  .pano__fs { position: absolute; right: var(--space-sm); top: var(--space-sm); z-index: 3; width: 44px; height: 44px; display: grid; place-items: center; border: var(--rule-hair) solid var(--color-ink); border-radius: var(--radius-pill); background: var(--color-paper-2); color: var(--color-ink); cursor: pointer; }
  .pano__fs:hover { background: var(--color-accent); }
  .pano__hint { position: absolute; left: 50%; bottom: var(--space-md); transform: translateX(-50%); z-index: 3; margin: 0; padding: var(--space-xs) var(--space-md); border-radius: var(--radius-pill); background: var(--color-ink); color: var(--color-on-ink); font-size: var(--text-sm); pointer-events: none; white-space: nowrap; }
  .pano__scenes { display: flex; gap: var(--space-xs); overflow-x: auto; scrollbar-width: none; padding-bottom: var(--space-3xs); }
  .pano__scenes::-webkit-scrollbar { display: none; }
  .pano__scenes button { flex-shrink: 0; min-height: 40px; padding: 0 var(--space-md); border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-pill); background: var(--color-paper-2); color: var(--color-ink-2); font: 500 var(--text-sm)/1 var(--font-body); cursor: pointer; box-shadow: var(--lift-top); }
  .pano__scenes button:hover { border-color: var(--color-muted); }
  .pano__scenes button:active { transform: translateY(1px); }
  .pano__scenes button[aria-pressed='true'] { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-on-ink); box-shadow: none; }
  .pano :global(.pnlm-container) { background: var(--color-paper-3); }
  .pano :global(.pnlm-load-box) { background: var(--color-ink); border-radius: var(--radius-card); font-family: var(--font-body); }
  .pano :global(.pnlm-about-msg) { display: none !important; }
</style>
