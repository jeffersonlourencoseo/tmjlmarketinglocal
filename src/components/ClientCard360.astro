---
import type { Client } from "../data/clients.ts";

interface Props {
  client: Client;
  compact?: boolean;
}

const { client, compact = false } = Astro.props;
const count = client.photos.length;
const thumbWebp = `${client.thumbnail}.webp`;
const thumbJpg = `${client.thumbnail}.jpg`;
---

<article
  class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition-all duration-300 hover:border-accent/50 hover:bg-white/[0.06] hover:shadow-[0_0_40px_-12px_rgba(201,162,39,0.25)] hover:-translate-y-1"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <picture>
      <source srcset={thumbWebp} type="image/webp" />
      <img
        src={thumbJpg}
        alt={`Foto 360° de ${client.name}`}
        loading="lazy"
        decoding="async"
        width="600"
        height="450"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/50 to-transparent"></div>

    <div class="absolute bottom-0 left-0 right-0 p-6">
      <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-accent">
        {client.category}
      </p>
      <h3 class="font-display text-2xl font-semibold text-secondary">
        {client.name}
      </h3>
      <p class="mt-1 text-sm text-white/80">
        {count} {count === 1 ? "ambiente" : "ambientes"}
      </p>
    </div>
  </div>

  <div class="p-6 space-y-3">
    {
      client.tourUrl && !compact && (
        <a
          href={client.tourUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-accent bg-accent px-6 py-3.5 text-sm font-semibold uppercase tracking-wider text-primary transition-all duration-200 hover:bg-accent-light hover:scale-[1.02] active:scale-95"
        >
          <span>Tour Interativo 360º</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5 5c0 2.2 2.2 4 5 5z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </a>
      )
    }
    {
      compact ? (
        <a
          href="/fotos-360/"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-accent px-6 py-3.5 text-sm font-semibold uppercase tracking-wider text-accent transition-all duration-200 hover:bg-accent hover:text-primary hover:scale-[1.02] active:scale-95"
        >
          <span>Ver projeto</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      ) : (
        <button
          type="button"
          data-open-viewer={client.id}
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-accent px-6 py-3.5 text-sm font-semibold uppercase tracking-wider text-accent transition-all duration-200 hover:bg-accent hover:text-primary hover:scale-[1.02] active:scale-95"
        >
          <span>Fotos 360°</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="m16 12-4-4-4 4"></path>
            <path d="M12 16V8"></path>
          </svg>
        </button>
      )
    }
  </div>
</article>
