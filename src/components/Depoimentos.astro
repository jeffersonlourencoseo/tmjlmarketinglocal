---
import { depoimentos } from '../data/depoimentos';
interface Props { title?: string }
const { title = 'O que dizem os clientes' } = Astro.props;
---
<section class="section dep" aria-labelledby="dep-t">
  <div class="container">
    <div class="head"><h2 id="dep-t">{title}</h2></div>
    <ul class="dep__list" role="list">
      {depoimentos.map((d) => (
        <li>
          <figure class="dep__item">
            <span class="dep__stars" aria-label="5 de 5 estrelas">★★★★★</span>
            <blockquote><p>“{d.text}”</p></blockquote>
            <figcaption><strong>{d.name}</strong><span class="caption">{d.role}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .dep__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); border-top: var(--rule-hair) solid var(--color-ink); }
  @media (min-width: 56rem) { .dep__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } .dep__list li + li { border-left: var(--rule-hair) solid var(--color-rule); padding-left: var(--space-xl); } .dep__list li:not(:last-child) { padding-right: var(--space-xl); } }
  .dep__list li { padding-block: var(--space-xl); border-bottom: var(--rule-hair) solid var(--color-rule); }
  @media (min-width: 56rem) { .dep__list li { border-bottom: 0; } }
  .dep__item { margin: 0; display: grid; grid-template-rows: auto 1fr auto; gap: var(--space-lg); height: 100%; }
  .dep__stars { color: var(--color-ink); letter-spacing: 0.1em; font-size: var(--text-lg); }
  .dep__item blockquote { margin: 0; }
  .dep__item blockquote p { font: 500 var(--text-lg)/1.45 var(--font-body); color: var(--color-ink); text-indent: -0.4em; max-width: none; }
  .dep__item figcaption { display: grid; gap: var(--space-3xs); }
</style>
