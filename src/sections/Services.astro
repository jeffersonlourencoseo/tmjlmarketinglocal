---
import ServiceCard from "../components/ServiceCard.astro";

const services = [
  {
    number: "01",
    title: "Criação e Configuração",
    description: "Criamos ou auditamos seu Google Meu Negócio do zero, preenchendo categorias, NAP, descrição otimizada, atributos e serviços para indexação rápida."
  },
  {
    number: "02",
    title: "Otimização Local e Imagens",
    description: "Aplicamos palavras-chave de intenção local, geotagueamos fotos e organizamos o conteúdo visual para aumentar a relevância do seu perfil no Rio de Janeiro."
  },
  {
    number: "03",
    title: "Postagens e Perguntas",
    description: "Mantemos seu perfil ativo com Google Posts semanais e perguntas/respostas estratégicas que educam o cliente e fortalecem o ranqueamento."
  },
  {
    number: "04",
    title: "Reputação e Avaliações",
    description: "Estratégia ética para aumentar o volume e a qualidade das avaliações, com resposta a 100% dos comentários e monitoramento contínuo."
  },
  {
    number: "05",
    title: "Monitoramento e Relatórios",
    description: "Acompanhamos visualizações, ligações, cliques, rotas e posição no mapa para mostrar a evolução real do seu perfil a cada mês."
  },
  {
    number: "06",
    title: "Fotos e Tour Virtual 360°",
    description: "Imagens esféricas e tours navegáveis publicados diretamente no Google Meu Negócio, para o cliente conhecer seu ambiente antes de sair de casa."
  }
];
---

<section id="servicos" class="relative py-28 lg:py-36 bg-secondary">
  <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-primary to-secondary"></div>

  <div class="container mx-auto px-6 lg:px-12 relative">
    <div class="max-w-3xl mb-20 lg:mb-24 pt-8">
      <p class="text-accent font-semibold tracking-[0.2em] uppercase text-sm mb-4">
        O que fazemos
      </p>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-tight mb-6">
        Serviços para colocar seu negócio no mapa
      </h2>
      <p class="text-lg text-muted">
        Seis pilares que transformam seu perfil local em uma máquina de atrair clientes qualificados no Rio de Janeiro.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {services.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>
  </div>
</section>
