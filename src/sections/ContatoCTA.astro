---
import { siteConfig } from "../data/config";

const phone = siteConfig.contact.phone;
const phoneLink = `tel:${siteConfig.contact.phoneRaw}`;
const whatsappLink = siteConfig.contact.whatsappLink;
---

<section class="relative py-28 lg:py-36 bg-primary overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-accent/10 rounded-full blur-[160px]"></div>
  </div>

  <div class="container mx-auto px-6 lg:px-12 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-accent font-semibold tracking-[0.2em] uppercase text-sm mb-6">
        Vamos conversar
      </p>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-8">
        Pronto para aparecer no Google?
      </h2>
      <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-12 leading-relaxed">
        Fale com a TMJL Marketing Local e receba uma proposta personalizada para colocar seu negócio no topo do Google Meu Negócio no Rio de Janeiro.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-accent text-primary font-bold rounded-full hover:bg-accent-light transition-all duration-200 hover:shadow-[0_0_40px_-10px_rgba(201,162,39,0.5)]"
        >
          Conversar no WhatsApp
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <a
          href={phoneLink}
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-white/20 text-white font-semibold rounded-full hover:bg-white/10 transition-all duration-200"
        >
          Ligar agora
          <span class="text-accent">{phone}</span>
        </a>
      </div>
    </div>
  </div>
</section>
