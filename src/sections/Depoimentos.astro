---
const depoimentos = [
  {
    name: "Carla Mendes",
    role: "Clínica de Estética",
    text: "Antes da TMJL nosso perfil nem aparecia no mapa. Em dois meses começamos a receber ligações diárias de novas clientes. O trabalho é transparente e o resultado é real.",
    rating: 5
  },
  {
    name: "Roberto Damasceno",
    role: "Oficina Mecânica",
    text: "A equipe cuidou de tudo: fotos, descrição, postagens e avaliações. Hoje somos um dos primeiros da nossa região quando alguém busca oficina no Google.",
    rating: 5
  },
  {
    name: "Fernanda Lima",
    role: "Restaurante",
    text: "As fotos 360° fizeram total diferença. Os clientes dizem que conheceram o ambiente antes de vir. O atendimento da TMJL é próximo e rápido.",
    rating: 5
  }
];
---

<section class="relative py-28 lg:py-36 bg-surface">
  <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-secondary to-surface"></div>

  <div class="container mx-auto px-6 lg:px-12 relative">
    <div class="max-w-3xl mb-20 lg:mb-24 pt-8">
      <p class="text-accent font-semibold tracking-[0.2em] uppercase text-sm mb-4">
        Depoimentos
      </p>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-tight mb-6">
        O que dizem nossos clientes
      </h2>
      <p class="text-lg text-muted">
        Negócios do Rio de Janeiro que já conquistaram mais visibilidade no Google Meu Negócio.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      {depoimentos.map((item) => (
        <div class="p-8 lg:p-10 bg-secondary rounded-2xl border border-gold flex flex-col">
          <div class="flex gap-1 mb-6">
            {Array.from({ length: item.rating }).map(() => (
              <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <blockquote class="text-lg text-primary leading-relaxed mb-8 flex-1">
            “{item.text}”
          </blockquote>

          <div class="mt-auto">
            <p class="font-bold text-primary">
              {item.name}
            </p>
            <p class="text-sm text-muted">
              {item.role}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
