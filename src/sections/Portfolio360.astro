---
import ClientCard360 from "../components/ClientCard360.astro";
import { clients } from "../data/clients.ts";

const featuredClients = clients.slice(0, 6);
---

<section class="relative py-28 lg:py-36 bg-surface-dark">
  <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-secondary to-surface-dark"></div>

  <div class="container mx-auto px-6 lg:px-12 relative">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10 mb-20 lg:mb-24 pt-8">
      <div class="max-w-2xl">
        <p class="text-accent font-semibold tracking-[0.2em] uppercase text-sm mb-4">
          Portfólio 360°
        </p>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-secondary leading-tight mb-6">
          Experiências imersivas que convertem
        </h2>
        <p class="text-lg text-white/80">
          Fotos e tours virtuais em 360° publicados no Google Meu Negócio. O cliente conhece seu ambiente antes de sair de casa.
        </p>
      </div>

      <a
        href="/fotos-360/"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-accent text-accent font-semibold rounded-full hover:bg-accent hover:text-primary transition-all duration-200 shrink-0"
      >
        Ver portfólio completo
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {featuredClients.map((client) => <ClientCard360 client={client} compact />)}
    </div>
  </div>
</section>
